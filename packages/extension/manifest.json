{
  "manifest_version": 3,
  "name": "entziffer",
  "version": "0.2.0",
  "description": "Decrypts ENTZ1 tokens on the sites you enable, using a key that never leaves this browser.",
  "minimum_chrome_version": "133",
  "key": "",
  "permissions": ["storage", "scripting", "alarms", "activeTab"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
