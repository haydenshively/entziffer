{
  "name": "@entziffer/extension",
  "version": "0.2.0",
  "description": "Chrome MV3 extension that decrypts ENTZ1 tokens in place on the sites you enable.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "zip": "pnpm run build && node scripts/zip.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm run build:e2e && playwright test"
  },
  "dependencies": {
    "@entziffer/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
