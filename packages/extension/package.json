{
  "name": "@entziffer/extension",
  "version": "0.2.1",
  "description": "Chrome MV3 extension that decrypts ENTZ1 tokens in place on the sites you enable.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "zip": "pnpm run build && node scripts/zip.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm run build:e2e && playwright test"
  },
  "dependencies": {
    "@entziffer/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "30.1.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
