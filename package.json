{
  "name": "entziffer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @entziffer/extension test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "zip": "pnpm --filter @entziffer/extension zip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
